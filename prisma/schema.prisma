generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Recipe {
  id           Int    @id @default(autoincrement())
  name         String
  ingredients  String @default("")
  instructions String @default("")
  tags         String @default("")
  liked_by     String @default("")
  url          String @default("")
  photo_url    String @default("")
  duration     String @default("")
  meals        Meal[]
  plans        Plan[]
}

model Meal {
  id        Int    @id @default(autoincrement())
  recipe_id Int
  ate_on    String
  notes     String @default("")
  recipe    Recipe @relation(fields: [recipe_id], references: [id], onDelete: Cascade)
}

model WeekCook {
  week String @unique
  cook String  @default("")
}

model Plan {
  id        Int     @id @default(autoincrement())
  date      String  @unique
  recipe_id Int?
  eaters    String  @default("")
  recipe    Recipe? @relation(fields: [recipe_id], references: [id], onDelete: SetNull)
}
